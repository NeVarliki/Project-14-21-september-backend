<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.0.xsd
        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <changeSet id="2026-09-19--0003-place" author="JVyacheslav">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="place"/>
            </not>
        </preConditions>
        <createTable tableName="place">
            <column name="id" autoIncrement="true" type="BIGINT"><constraints primaryKey="true" nullable="false"/></column>
            <column name="place_name" type="varchar(255)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>